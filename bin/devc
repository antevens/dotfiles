#!/bin/bash
#
# Create, start and attach to devcontainers for the current repository.
# Repositories without their own .devcontainer use the shared default config.

set -o errexit
set -o nounset
set -o pipefail

readonly default_config="${DEVC_CONFIG:-${HOME}/.config/devcontainer/devcontainer.json}"

#######################################
# Print an error message to stderr.
# Arguments:
#   Message to print.
#######################################
function err() {
  echo "devc: $*" >&2
}

#######################################
# Print usage information.
# Outputs:
#   Usage text to stdout.
#######################################
function usage() {
  cat <<EOF
Usage: devc <command> [args...]

Commands:
  up          Create and start the devcontainer
  shell [cmd] Open a login shell (or run cmd) in the devcontainer, starting it if needed
  claude      Run claude in the devcontainer, starting it if needed
  rebuild     Recreate the devcontainer from scratch
  stop        Stop the devcontainer
  rm          Remove the devcontainer
  init        Copy the shared config into .devcontainer/ for per-repo customisation
  ls          List all devcontainers

The workspace is the git top-level of the current directory, or the current
directory outside a git repository. Set DEVC_CONFIG to use another default
config.
EOF
}

#######################################
# Print the workspace folder for the current directory.
# Outputs:
#   Absolute path of the workspace folder.
#######################################
function workspace_folder() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

#######################################
# Print devcontainer CLI arguments selecting the workspace and config.
# Arguments:
#   Workspace folder.
# Outputs:
#   One argument per line.
#######################################
function config_args() {
  local workspace="$1"
  printf '%s\n' --workspace-folder "${workspace}"
  if [[ ! -f "${workspace}/.devcontainer/devcontainer.json" \
    && ! -f "${workspace}/.devcontainer.json" ]]; then
    printf '%s\n' --override-config "${default_config}"
  fi
}

#######################################
# Print the ID of the container for a workspace.
# Arguments:
#   Workspace folder.
#   Optional extra docker ps flag, e.g. --all.
# Outputs:
#   Container ID, empty if none exists.
#######################################
function container_id() {
  local workspace="$1"
  shift
  docker ps --quiet "$@" --filter "label=devcontainer.local_folder=${workspace}"
}

#######################################
# Create and start the devcontainer.
# Lockfiles are disabled for the shared config as there is no
# .devcontainer directory to write them to.
# Arguments:
#   Workspace folder.
#   Extra devcontainer up arguments.
#######################################
function up() {
  local workspace="$1"
  shift
  local -a args
  mapfile -t args < <(config_args "${workspace}")
  if [[ " ${args[*]} " == *" --override-config "* ]]; then
    args+=(--no-lockfile)
  fi
  devcontainer up "${args[@]}" "$@"
}

#######################################
# Start the devcontainer if it is not running.
# Arguments:
#   Workspace folder.
#######################################
function ensure_up() {
  local workspace="$1"
  if [[ -z "$(container_id "${workspace}")" ]]; then
    up "${workspace}"
  fi
}

#######################################
# Run a command in the devcontainer.
# Arguments:
#   Workspace folder.
#   Command and arguments.
#######################################
function exec_in() {
  local workspace="$1"
  shift
  local -a args
  ensure_up "${workspace}"
  mapfile -t args < <(config_args "${workspace}")
  exec devcontainer exec "${args[@]}" "$@"
}

function main() {
  local command="${1:-}"
  local workspace
  local id
  if [[ $# -gt 0 ]]; then
    shift
  fi

  if [[ ! -f "${default_config}" ]]; then
    err "default config not found: ${default_config}"
    exit 1
  fi
  workspace="$(workspace_folder)"

  case "${command}" in
    up)
      up "${workspace}" "$@"
      ;;
    shell)
      if [[ $# -eq 0 ]]; then
        exec_in "${workspace}" bash -l
      else
        exec_in "${workspace}" "$@"
      fi
      ;;
    claude)
      exec_in "${workspace}" claude "$@"
      ;;
    rebuild)
      up "${workspace}" --remove-existing-container "$@"
      ;;
    stop)
      id="$(container_id "${workspace}")"
      if [[ -n "${id}" ]]; then
        docker stop "${id}"
      fi
      ;;
    rm)
      id="$(container_id "${workspace}" --all)"
      if [[ -n "${id}" ]]; then
        docker rm --force "${id}"
      fi
      ;;
    init)
      if [[ -e "${workspace}/.devcontainer/devcontainer.json" ]]; then
        err "${workspace}/.devcontainer/devcontainer.json already exists"
        exit 1
      fi
      mkdir -p "${workspace}/.devcontainer"
      cp "${default_config}" "${workspace}/.devcontainer/devcontainer.json"
      echo "Created ${workspace}/.devcontainer/devcontainer.json"
      ;;
    ls)
      docker ps --all --filter "label=devcontainer.local_folder" \
        --format 'table {{.ID}}\t{{.Status}}\t{{.Label "devcontainer.local_folder"}}'
      ;;
    -h | --help | help | "")
      usage
      ;;
    *)
      err "unknown command: ${command}"
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"

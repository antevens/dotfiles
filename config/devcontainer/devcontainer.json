{
  "name": "${localWorkspaceFolderBasename}",
  "image": "mcr.microsoft.com/devcontainers/base:resolute",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=devcontainer-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "DEVC_WORKSPACE": "${localWorkspaceFolderBasename}"
  },
  "postCreateCommand": {
    "claude-config": "sudo chown vscode:vscode /home/vscode/.claude",
    "bashrc": "printf '%s\\n' 'PS1=${PS1/\\\\u /${DEVC_WORKSPACE} }' \"alias c='claude --dangerously-skip-permissions'\" >> ~/.bashrc"
  },
  "remoteUser": "vscode"
}
